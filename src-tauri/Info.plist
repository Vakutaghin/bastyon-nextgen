<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Этот файл мержится в Info.plist macOS-бандла (Tauri подхватывает
  `src-tauri/Info.plist` автоматически).

  CFBundleURLTypes регистрирует приложение обработчиком `bastyon://` и
  исторической схемы `pocketnet://` в LaunchServices. Плагин deep-link знает
  схемы из `tauri.conf.json`, но на macOS решает именно Info.plist бандла —
  держим их здесь явно, чтобы регистрация не зависела от версии CLI.

  NSMicrophoneUsageDescription и NSCameraUsageDescription — текст системного
  запроса доступа. Без них macOS не даёт приложению микрофон (голосовой ввод,
  голосовые сообщения) и камеру (QR-код при входе). К ним нужны и права
  hardened runtime в entitlements.plist.

  NSBluetoothAlwaysUsageDescription — Bluetooth до LoRa-радио (mesh-сети).
  Без него macOS закрывает приложение при первом обращении к Bluetooth. Права
  hardened runtime для Bluetooth нет: оно есть только у песочницы App Store.
-->
<plist version="1.0">
  <dict>
    <key>NSMicrophoneUsageDescription</key>
    <string>Bastyon uses the microphone for voice input and voice messages. Speech is recognized on this computer.</string>
    <key>NSCameraUsageDescription</key>
    <string>Bastyon uses the camera to scan a QR code when you sign in.</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Bastyon connects over Bluetooth to your LoRa radio to chat in mesh networks.</string>
    <key>CFBundleURLTypes</key>
    <array>
      <dict>
        <key>CFBundleURLName</key>
        <string>com.bastyon.app</string>
        <key>CFBundleTypeRole</key>
        <string>Viewer</string>
        <key>CFBundleURLSchemes</key>
        <array>
          <string>bastyon</string>
          <string>pocketnet</string>
        </array>
      </dict>
    </array>
  </dict>
</plist>
