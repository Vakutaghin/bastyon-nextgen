{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions; http scope: any https host + local IPFS gateway (V27) — mini-app URLs are filtered client-side (safe-external-url, V25)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-set-webview-zoom",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "dialog:allow-save",
    "dialog:allow-open",
    "dialog:default",
    "fs:allow-write-file",
    "fs:scope-download",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://**:*/**" }, { "url": "http://127.0.0.1:*/**" }]
    }
  ]
}
