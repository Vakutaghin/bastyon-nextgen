<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Права hardened runtime для macOS-бандла (tauri.conf.json → bundle.macOS.entitlements).
  Бандл подписывается с hardened runtime, и без этих ключей macOS молча не даёт
  микрофон (голосовой ввод, голосовые сообщения) и камеру (QR-код при входе),
  даже если пользователь разрешил доступ. Тексты запросов — в Info.plist.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
  </dict>
</plist>
