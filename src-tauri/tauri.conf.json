{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Bastyon",
  "version": "0.1.0",
  "identifier": "com.bastyon.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1990",
    "beforeDevCommand": "VITE_PORT=1990 VITE_TAURI=true npm run dev",
    "beforeBuildCommand": "VITE_TAURI=true npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Bastyon",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "center": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "msi",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "",
    "category": "Utility",
    "shortDescription": "Bastyon Desktop Application",
    "longDescription": "Bastyon - Decentralized Social Network Desktop Application"
  }
}
